{
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo.html"
    }
  ],
  "redirects": [
    {
      "source": "/r/:token",
      "destination": "https://app.voicereason.ai/r/:token",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "https://app.voicereason.ai/terms",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "https://app.voicereason.ai/terms",
      "permanent": true
    }
  ]
}
